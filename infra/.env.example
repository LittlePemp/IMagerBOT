# Generated local credentials belong in infra/.env, never in Git.
# Run: py -3.12 infra/setup.py
IMAGER_DATA_ROOT=../.local/data
IMAGER_SECRETS_ROOT=../.local/secrets
MONGO_PASSWORD=replace_with_generated_password
MINIO_ACCESS_KEY=replace_with_generated_access_key
MINIO_SECRET_KEY=replace_with_generated_secret_key
TEMPORAL_UI_PORT=8088
MINIO_CONSOLE_PORT=9001
API_TOKEN=
TELEGRAM_ADMIN_IDS=
# Optional local directory containing theme subdirectories for import-catalog.
IMAGER_IMPORT_ROOT=../imager/files/groups

# Generated local credentials belong in infra/.env, never in Git.
# Run: py -3.12 infra/setup.py
# Operational defaults and filenames come from config/imager.toml.
# setup.py writes the resolved absolute paths required by Compose.
MONGO_PASSWORD=replace_with_generated_password
MINIO_ACCESS_KEY=replace_with_generated_access_key
MINIO_SECRET_KEY=replace_with_generated_secret_key
API_TOKEN=
TELEGRAM_ADMIN_IDS=
# Optional local overrides (otherwise setup uses TOML defaults):
# IMAGER_DATA_ROOT=/dedicated/project/data
# IMAGER_CONFIG_SOURCE=/path/to/runtime-override.toml
# IMAGER_IMPORT_ROOT=/path/to/theme-directories
